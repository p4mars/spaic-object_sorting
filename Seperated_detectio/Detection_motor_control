import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist, PoseStamped, PoseWithCovarianceStamped
from std_msgs.msg import String
import math
import time


class MotorControlNode(Node):
    def __init__(self):
        super().__init__("motor_control_node")

        # Subscribe to odometry (robot pose in odom frame)
        self.create_subscription(
            PoseWithCovarianceStamped,
            "/robot_pose",
            self.odom_cb,
            10
        )

        # Subscribe to block target (odom frame)
        self.create_subscription(
            PoseStamped,
            "/detected_object/pos",
            self.target_cb,
            10
        )

        # Publishers
        self.cmd_pub = self.create_publisher(Twist, "/mirte_base_controller/cmd_vel", 10)
        self.pickup_pub = self.create_publisher(String, "/activate_pickup", 10)
        self.detect_pub = self.create_publisher(String, "/activate_detection", 10)

        # Current odom pose
        self.x = 0.0
        self.y = 0.0
        self.yaw = 0.0

        # Control parameters
        self.rot_speed = 0.4
        self.drive_speed = 0.15
        self.strafe_speed = 0.12

        self.angle_tol = math.radians(5)
        self.pos_tol = 0.02

        self.get_logger().info("ODOM-based motor control node ready")

    # ODOM CALLBACK
    def odom_cb(self, msg):
        self.x = msg.pose.pose.position.x
        self.y = msg.pose.pose.position.y

        # Extract yaw from quaternion
        q = msg.pose.pose.orientation
        self.yaw = math.atan2(2*(q.w*q.z + q.x*q.y),
                              1 - 2*(q.y*q.y + q.z*q.z))


    # TARGET CALLBACK
    def target_cb(self, msg):

        # Stop detection
        stop_msg = String()
        stop_msg.data = "stop"
        self.detect_pub.publish(stop_msg)

        tx = msg.pose.position.x
        ty = msg.pose.position.y

        # Compute target yaw
        yaw_target = math.atan2(ty, tx)

        # Compute absolute target position in odom
        dist = math.sqrt(tx*tx + ty*ty)
        target_x = self.x + tx
        target_y = self.y + ty

        self.get_logger().info(
            f"[MOTOR] Target odom=({target_x:.3f}, {target_y:.3f}), yaw={yaw_target:.3f}"
        )

        # Rotate to face block
        self.rotate_to_yaw(yaw_target)

        # Strafe to align laterally
        self.align_lateral(target_y)

        # Drive forward to target
        self.drive_to_position(target_x, target_y)

        # Stop robot
        self.stop_robot()

        # Trigger pickup
        msg = String()
        msg.data = "start"
        self.pickup_pub.publish(msg)
        self.get_logger().info("[MOTOR] Pickup triggered")


    # ROTATION CONTROL (ODOM)
    def rotate_to_yaw(self, yaw_target):
        self.get_logger().info("[MOTOR] Rotating to face block")

        twist = Twist()

        while rclpy.ok():
            yaw_error = self.normalize_angle(yaw_target - self.yaw)

            if abs(yaw_error) < self.angle_tol:
                break

            twist.angular.z = self.rot_speed * (1 if yaw_error > 0 else -1)
            self.cmd_pub.publish(twist)
            time.sleep(0.05)

        self.stop_robot()


    # LATERAL ALIGNMENT (ODOM)
    def align_lateral(self, target_y):
        self.get_logger().info("[MOTOR] Aligning laterally")

        twist = Twist()

        while rclpy.ok():
            y_error = target_y - self.y

            if abs(y_error) < self.pos_tol:
                break

            twist.linear.y = self.strafe_speed * (1 if y_error > 0 else -1)
            self.cmd_pub.publish(twist)
            time.sleep(0.05)

        self.stop_robot()


    # FORWARD DRIVE (ODOM)
    def drive_to_position(self, target_x, target_y):
        self.get_logger().info("[MOTOR] Driving forward")

        twist = Twist()

        while rclpy.ok():
            dx = target_x - self.x
            dy = target_y - self.y
            dist = math.sqrt(dx*dx + dy*dy)

            if dist < self.pos_tol:
                break

            twist.linear.x = self.drive_speed
            self.cmd_pub.publish(twist)
            time.sleep(0.05)

        self.stop_robot()


    # STOP ROBOT
    def stop_robot(self):
        twist = Twist()
        self.cmd_pub.publish(twist)
        time.sleep(0.1)


    # ANGLE NORMALIZATION
    def normalize_angle(self, a):
        while a > math.pi:
            a -= 2*math.pi
        while a < -math.pi:
            a += 2*math.pi
        return a


def main():
    rclpy.init()
    node = MotorControlNode()
    rclpy.spin(node)
    rclpy.shutdown()


if __name__ == "__main__":
    main()
