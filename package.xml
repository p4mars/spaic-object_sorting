<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mirte_sorting</name>
  <version>1.0.0</version>
  <description>
    Unified sorting robot package for MIRTE Master — AE4ASM527 Group 2.
    Integrates shape detection (YOLO), AprilTag localisation, SLAM mapping,
    Nav2 navigation with obstacle avoidance, and arm manipulation into a
    single autonomous sorting mission.
  </description>
  <maintainer email="student@tudelft.nl">AE4ASM527 Group 2</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>nav2_simple_commander</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>apriltag_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>topic_tools</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
